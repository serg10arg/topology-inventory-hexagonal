<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>topology-inventory</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>framework</artifactId>

    <properties>
        <!--
         ~ JUnit alineado con la plataforma Quarkus SOLO en este modulo. quarkus-junit5
         ~ 3.33 corre sobre JUnit 6.0.3 (jupiter y platform ya comparten numeracion) y
         ~ falla con el 5.11.3 del POM raiz: NoSuchMethodError LauncherSession.getStore.
         ~ El pin del raiz no se toca porque 'application' prueba con Cucumber 7.x, que
         ~ va contra JUnit Platform 1.x. Sobrescribir aqui la propiedad basta: Maven
         ~ interpola el junit-bom y el junit-jupiter heredados con el valor del hijo.
         -->
        <junit.version>6.0.3</junit.version>
    </properties>

    <dependencies>
        <!-- Hexágonos internos: el framework depende de application y domain -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
         ~ Frontera de persistencia (SC2a): EclipseLink y persistence.xml se retiran
         ~ por completo y la gestion pasa a Quarkus.
         ~  - quarkus-hibernate-orm: el proveedor JPA (Hibernate ORM) que mapea las
         ~    entidades y, con database.generation=drop-and-create, genera el DDL.
         ~  - quarkus-jdbc-h2: driver H2 gobernado por Quarkus (sustituye al h2 suelto).
         ~  - quarkus-agroal: pool de conexiones que Quarkus exige para el datasource.
         ~ jakarta.persistence-api se declara SIN <version> (la aporta el quarkus-bom)
         ~ para casar con 'requires jakarta.persistence' del module-info sin fijar una
         ~ version que pudiera chocar con la de Hibernate.
         -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>
        <!--
         ~ SPI estandar de Jakarta con la que el output adapter (no es bean CDI)
         ~ toma del contenedor el EntityManager (CDI.current()) y la UserTransaction.
         ~ Sin <version>: la gobierna el quarkus-bom. Casan con 'requires jakarta.cdi'
         ~ y 'requires jakarta.transaction' del module-info.
         -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
        </dependency>

        <!--
         ~ Frontera REST (lado de entrada): quarkus-rest es RESTEasy Reactive (nombre
         ~ vigente desde Quarkus 3.9; antes quarkus-resteasy-reactive) y quarkus-rest-jackson
         ~ aporta la (de)serializacion JSON de los DTOs. Sin <version>: los gobierna el
         ~ quarkus-bom. Casan con 'requires jakarta.ws.rs', 'io.smallrye.mutiny' e
         ~ 'io.smallrye.common.annotation' del module-info; los dos ultimos llegan
         ~ transitivamente por quarkus-rest.
         -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
         ~ Test de integracion bajo Quarkus: @QuarkusTest arranca el contenedor
         ~ (Arc + EntityManager + seed del perfil 'test') para ejercitar el round-trip
         ~ real del output adapter. Los tests corren en classpath, donde ServiceLoader
         ~ resuelve el output port via META-INF/services.
         -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
         ~ REST Assured: cliente HTTP para probar los endpoints del adapter REST por HTTP
         ~ real contra el servidor que levanta @QuarkusTest. Sin <version>: la gobierna el
         ~ quarkus-bom.
         -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
             ~ Los tests de este modulo corren en CLASSPATH, no en module path.
             ~ Surefire, al ver el module-info de src/main, arrancaba el JVM de test
             ~ con module path: el 'provides' del descriptor cargaba una SEGUNDA copia
             ~ del output adapter con el classloader del sistema, mientras @QuarkusTest
             ~ trabaja con la suya en el QuarkusClassLoader. ServiceLoader las cruzaba
             ~ y fallaba con "not a subtype" pese a que ambas clases eran correctas.
             ~ En classpath solo queda el binding de META-INF/services, que es el que
             ~ Quarkus usa tambien en produccion.
             -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>