<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>topology-inventory</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>framework</artifactId>

    <properties>
        <!--
         ~ JUnit alineado con la plataforma Quarkus SOLO en este modulo. quarkus-junit5
         ~ 3.33 corre sobre JUnit 6.0.3 y falla con el 5.11.3 del POM raiz
         ~ (NoSuchMethodError LauncherSession.getStore). El pin del raiz no se toca porque
         ~ 'application' prueba con Cucumber 7.x (JUnit Platform 1.x). Sobrescribir aqui basta.
         -->
        <junit.version>6.0.3</junit.version>
    </properties>

    <dependencies>
        <!-- Hexagonos internos: el framework depende de application y domain -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
         ~ Frontera de persistencia REACTIVA (Fase 8, SC1). Se retira Hibernate ORM clasico
         ~ + JDBC H2 + Agroal (bloqueantes) y entra la pila reactiva:
         ~  - quarkus-hibernate-reactive: Hibernate Reactive PURO (sin Panache, decision D1).
         ~    Aporta Mutiny.SessionFactory, con el que el output adapter abre sesion y
         ~    transaccion reactivas y devuelve Uni.
         ~  - quarkus-reactive-mysql-client: el cliente MySQL no bloqueante de Vert.x. H2 no
         ~    es opcion: el vertx-sql-client no soporta H2 (es JDBC puro).
         ~ jakarta.persistence-api se mantiene SIN <version> (la aporta el quarkus-bom): las
         ~ entidades *Data siguen anotadas con JPA estandar. jakarta.transaction-api SALE:
         ~ @Transactional desaparece en favor de withTransaction reactivo.
         -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-reactive-mysql-client</artifactId>
        </dependency>

        <!--
         ~ SPI estandar de Jakarta CDI: los beans del framework (output adapter, REST adapters)
         ~ usan @ApplicationScoped e @Inject. Sin <version>: la gobierna el quarkus-bom. Casa
         ~ con 'requires jakarta.cdi' del module-info. (jakarta.transaction-api retirada.)
         -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <!--
         ~ Frontera REST (lado de entrada): quarkus-rest (RESTEasy Reactive) + quarkus-rest-jackson
         ~ (JSON de los DTOs). Sin <version>: quarkus-bom. Casan con 'requires jakarta.ws.rs' e
         ~ 'io.smallrye.mutiny' del module-info (este ultimo, transitivo por quarkus-rest y ahora
         ~ tambien por hibernate-reactive).
         -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <!--
         ~ Contrato de la API: quarkus-smallrye-openapi genera /q/openapi y sirve Swagger UI.
         ~ Casa con 'requires org.eclipse.microprofile.openapi' del module-info.
         -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
         ~ Test de integracion bajo Quarkus: @QuarkusTest arranca el contenedor (Arc +
         ~ Hibernate Reactive + MySQL via Dev Services + seed) para ejercitar el round-trip
         ~ reactivo del output adapter y los endpoints REST. Corren en classpath plano; Arc
         ~ descubre por Jandex.
         -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
         ~ quarkus-test-vertx: aporta UniAsserter y @RunOnVertxContext (decision D5), con los que
         ~ el test del output adapter afirma sobre la Uni SIN bloquear, en el contexto de Vert.x.
         -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-vertx</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
         ~ REST Assured: cliente HTTP para probar los endpoints por HTTP real contra el servidor
         ~ que levanta @QuarkusTest. Sin <version>: quarkus-bom.
         -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
             ~ Los tests de este modulo corren en CLASSPATH, no en module path. @QuarkusTest
             ~ arranca la app en su QuarkusClassLoader y Arc descubre los beans por Jandex. Con
             ~ useModulePath=false, JVM de test y QuarkusClassLoader comparten el mismo classpath
             ~ plano y no se cruzan classloaders.
             -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
