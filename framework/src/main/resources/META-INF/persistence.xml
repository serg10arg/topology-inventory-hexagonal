<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="inventory" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <class>com.example.topologyinventory.framework.adapters.output.h2.data.RouterData</class>
        <class>com.example.topologyinventory.framework.adapters.output.h2.data.SwitchData</class>
        <class>com.example.topologyinventory.framework.adapters.output.h2.data.LocationData</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:inventory;MODE=MYSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;IGNORECASE=TRUE"/>
            <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.H2Platform"/>
            <property name="eclipselink.logging.level" value="info"/>

            <!--
             ~ El esquema y los datos los aporta EclipseLink desde scripts, una sola
             ~ vez al desplegar la unidad. 'create-source=script' hace que EclipseLink
             ~ NO genere DDL desde las entidades: schema.sql (escrito a mano) sigue
             ~ siendo la autoridad del esquema. Se sustituye así el antiguo
             ~ 'INIT=...RUNSCRIPT' de la URL (que re-creaba las tablas en cada
             ~ conexión) y se elimina 'schema-generation.scripts.action' (que exigía
             ~ un create-target y provocaba el fallo de despliegue).
             -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
            <property name="jakarta.persistence.schema-generation.create-source" value="script"/>
            <property name="jakarta.persistence.schema-generation.create-script-source" value="schema.sql"/>
            <property name="jakarta.persistence.sql-load-script-source" value="data.sql"/>
        </properties>
    </persistence-unit>
</persistence>